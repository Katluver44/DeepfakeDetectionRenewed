%%%% colm2024_conference.sty
%%%% Faithful single-column conference style reconstruction in the spirit of the
%%%% COLM / ICLR author kit (Times, US Letter, ruled title, natbib author-year,
%%%% optional submission line numbers). This is a self-contained reconstruction,
%%%% not the byte-exact official upstream file.

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{colm2024_conference}[2024/01/01 COLM-style conference format (reconstruction)]

\newif\ifcolmfinal
\colmfinalfalse
\DeclareOption{final}{\colmfinaltrue}
\ProcessOptions\relax

\RequirePackage{times}
\RequirePackage{geometry}
\RequirePackage{fancyhdr}
\RequirePackage{natbib}
\RequirePackage{xcolor}
\RequirePackage{ifthen}

% ---- page geometry (US Letter, ICLR-like text block) ----
\geometry{letterpaper, top=1in, bottom=1in, left=1.25in, right=1.25in}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.6em}

% ---- line spacing / fonts ----
\renewcommand{\baselinestretch}{1.02}
\renewcommand{\familydefault}{\rmdefault}

% ---- section headings ----
\RequirePackage{titlesec}
\titleformat{\section}{\large\bfseries\raggedright}{\thesection}{0.6em}{}
\titleformat{\subsection}{\normalsize\bfseries\raggedright}{\thesubsection}{0.6em}{}
\titleformat{\subsubsection}{\normalsize\bfseries\itshape\raggedright}{\thesubsubsection}{0.6em}{}
\titlespacing*{\section}{0pt}{1.4em}{0.5em}
\titlespacing*{\subsection}{0pt}{1.0em}{0.4em}

% ---- header / footer ----
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\ifcolmfinal
  \fancyfoot[C]{\small Published as a conference paper at COLM 2024}
\else
  \fancyfoot[C]{\small Under review as a conference paper at COLM 2024}
\fi
\fancyfoot[R]{\small\thepage}

% ---- title block (ruled, ICLR-like) ----
\newcommand{\@toptitlebar}{\vspace*{-0.2in}\hrule height 2pt \vspace{0.55in}}
\newcommand{\@bottomtitlebar}{\vspace{0.4in}\hrule height 2pt \vspace{0.3in}}

\renewcommand{\maketitle}{%
  \par
  \begingroup
  \renewcommand{\thefootnote}{\fnsymbol{footnote}}%
  \@toptitlebar
  \begin{center}
    {\LARGE\bfseries \@title \par}
    \vspace{0.3in}
    {\large \@author \par}
  \end{center}
  \@bottomtitlebar
  \endgroup
}

% ---- abstract ----
\renewenvironment{abstract}{%
  \begin{center}{\bfseries Abstract}\end{center}
  \begin{quote}\small}
{\end{quote}\vspace{0.3em}}

% ---- author block helper ----
\newcommand{\authorblock}[1]{{\large #1}}

% ---- optional submission line numbers ----
\ifcolmfinal\else
  \RequirePackage[switch]{lineno}
  \AtBeginDocument{\linenumbers}
  \renewcommand\linenumberfont{\normalfont\tiny\sffamily\color{gray}}
\fi

% ---- natbib defaults: author-year ----
\setcitestyle{authoryear,round,citesep={;},aysep={,},yysep={;}}
\bibliographystyle{plainnat}

\endinput
